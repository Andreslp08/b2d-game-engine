{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Node",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src/lib",
    "composite": true,
    "esModuleInterop": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,      
    "noUnusedParameters": true,  
    "noImplicitReturns": true   
  },
  "include": ["src/lib"],
  "exclude": ["dist", "node_modules"]
}
